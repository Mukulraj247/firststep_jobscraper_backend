    {
      "parameters": {
        "url": "https://api.scrape.do",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "bd9cb6c5e3d844a990262114007beded4bd7c20b578"
            },
