      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.processedJobs) {\n  staticData.processedJobs = [];\n}\n\nconst items = $input.all();\nfor (const item of items) {\n  staticData.processedJobs.push(item.json);\n}\n\nreturn items;"
