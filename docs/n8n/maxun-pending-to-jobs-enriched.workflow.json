      "id": "e3f4a5b6-scrape",
      "name": "scrape.do",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [1480, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  try {\n    const rawHtml = item.json.data.replace(/<[^>]*>/g, '');\n    const match = rawHtml.match(/\"apply_url\":\"([^\"]+)\"/);\n\n    if (match && match[1]) {\n      let applyUrl = match[1];\n      applyUrl = applyUrl.replace(/\\\\u([0-9a-fA-F]{4})/g, (match, hex) => {\n        return String.fromCharCode(parseInt(hex, 16));\n      });\n      applyUrl = applyUrl\n        .replace(/\\\\n/g, '\\n')\n        .replace(/\\\\r/g, '\\r')\n        .replace(/\\\\t/g, '\\t')\n        .replace(/\\\\\\\\/g, '\\\\')\n        .replace(/\\\\\"/g, '\"')\n        .replace(/\\\\'/g, \"'\");\n\n      return { json: { apply_url: applyUrl } };\n    } else {\n      return { json: { apply_url: null } };\n    }\n  } catch (error) {\n    return { json: { ...item.json, apply_url: null, error: error.message } };\n  }\n});"
      },
