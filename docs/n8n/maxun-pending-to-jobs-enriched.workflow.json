    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const prepared = $('Prepare update + job row').all();\nif (prepared.length !== items.length) {\n  throw new Error(`Shape: Prepare has ${prepared.length} items but Update passed ${items.length}`);\n}\nfunction pickJob(p) {\n  return {\n    jobId: p.jobId,\n    jobUrl: p.jobUrl,\n    jobSourceURL: p.jobSourceURL,\n    jobTitle: p.jobTitle,\n    companyName: p.companyName,\n    jobDescription: p.jobDescription,\n    jobCategory: p.jobCategory,\n    date: p.date,\n    createdBy: p.createdBy,\n    job_creation_type: p.job_creation_type,\n    status: p.status,\n    isFlagged: p.isFlagged,\n    jobExperience: p.jobExperience,\n    __v: p.__v,\n    createdAt: p.createdAt,\n    updatedAt: p.updatedAt,\n  };\n}\nreturn prepared.map(({ json: p }) => ({ json: pickJob(p) }));\n"
      },
