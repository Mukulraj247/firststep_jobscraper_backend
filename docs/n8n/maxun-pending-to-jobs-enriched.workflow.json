    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Set CREATED_BY after import (Auth0 subject).\nconst CREATED_BY = 'auth0|REPLACE_WITH_YOUR_AUTH0_SUBJECT';\nconst now = new Date().toISOString();\n\nreturn items.map(({ json: doc }) => {\n  const d = doc.data || {};\n  const dateVal = d.date ? new Date(d.date) : new Date(doc.createdAt || now);\n  return {\n    json: {\n      _id: doc._id,\n      'data.status': 'active',\n      jobId: d.jobId,\n      jobUrl: d.jobUrl ?? '',\n      jobSourceURL: d.jobUrl ?? '',\n      jobTitle: d.jobTitle ?? '',\n      companyName: d.companyName ?? '',\n      jobDescription: d.jobDescription ?? '',\n      jobCategory: d.jobCategory ?? '',\n      date: dateVal.toISOString(),\n      createdBy: CREATED_BY,\n      job_creation_type: 'automation',\n      status: 'active',\n      isFlagged: Boolean(d.isFlagged),\n      jobExperience: typeof d.jobExperience === 'number' ? d.jobExperience : 0,\n      __v: 0,\n      createdAt: now,\n      updatedAt: now,\n    },\n  };\n});\n"
      },
      "id": "d4e5f6a7-prepare",
      "name": "Prepare update + job row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 0]
