      "id": "e5f6a7b8-update-extracted",
      "name": "Mark extracted active",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.2,
      "position": [520, 0],
      "credentials": {
        "mongoDb": {
          "name": "MongoDB firststep_db"
